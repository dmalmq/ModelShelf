<?xml version="1.0" encoding="utf-8"?>
<ids xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd" xmlns="http://standards.buildingsmart.org/IDS">
  <info>
    <title>BLCJ S1000 demo pack v1</title>
    <description>Information checks authored from the BLCJ S1000 architecture (GLOOBE), structure (Revit/SS7), and MEP (Rebro) IFC exports themselves, cross-referenced against references/bim-checking's Sankai/MLIT/BLCJ source material. See packs/demo/checks.md for full source-to-property traceability and rationale.</description>
  </info>
  <specifications>
    <specification name="Room has a reference code" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCSPACE</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCIDENTIFIER">
          <propertySet><simpleValue>Pset_SpaceCommon</simpleValue></propertySet>
          <baseName><simpleValue>Reference</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Room records a net floor area" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCSPACE</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE">
          <propertySet><simpleValue>BaseQuantities</simpleValue></propertySet>
          <baseName><simpleValue>NetFloorArea</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Room records a ceiling height" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCSPACE</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCLENGTHMEASURE">
          <propertySet><simpleValue>BaseQuantities</simpleValue></propertySet>
          <baseName><simpleValue>NominalHeight</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Door or window has a schedule reference" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCDOOR" />
              <xs:enumeration value="IFCWINDOW" />
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCIDENTIFIER">
          <propertySet>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Pset_DoorCommon" />
              <xs:enumeration value="Pset_WindowCommon" />
            </xs:restriction>
          </propertySet>
          <baseName><simpleValue>Reference</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Door or window declares a fire rating" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCDOOR" />
              <xs:enumeration value="IFCWINDOW" />
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCLABEL">
          <propertySet>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Pset_DoorCommon" />
              <xs:enumeration value="Pset_WindowCommon" />
            </xs:restriction>
          </propertySet>
          <baseName><simpleValue>FireRating</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Structural column is load-bearing" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCCOLUMN</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN">
          <propertySet><simpleValue>Pset_ColumnCommon</simpleValue></propertySet>
          <baseName><simpleValue>LoadBearing</simpleValue></baseName>
          <value><simpleValue>true</simpleValue></value>
        </property>
      </requirements>
    </specification>

    <specification name="Structural column has a member mark" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCCOLUMN</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCIDENTIFIER">
          <propertySet><simpleValue>Pset_ColumnCommon</simpleValue></propertySet>
          <baseName><simpleValue>Reference</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Structural beam records its span" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBEAM</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCPOSITIVELENGTHMEASURE">
          <propertySet><simpleValue>Pset_BeamCommon</simpleValue></propertySet>
          <baseName><simpleValue>Span</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Structural slab is load-bearing" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCSLAB</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN">
          <propertySet><simpleValue>Pset_SlabCommon</simpleValue></propertySet>
          <baseName><simpleValue>LoadBearing</simpleValue></baseName>
          <value><simpleValue>true</simpleValue></value>
        </property>
      </requirements>
    </specification>

    <specification name="MEP flow segment records its usage" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCFLOWSEGMENT</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCTEXT">
          <propertySet><simpleValue>Rebro_PartsData</simpleValue></propertySet>
          <baseName><simpleValue>用途</simpleValue></baseName>
        </property>
      </requirements>
    </specification>

    <specification name="MEP flow segment records its outer diameter" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCFLOWSEGMENT</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCTEXT">
          <propertySet><simpleValue>Rebro_PartsData</simpleValue></propertySet>
          <baseName><simpleValue>外径[mm]</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
  </specifications>
</ids>
