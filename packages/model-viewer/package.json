  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/three": "^0.185.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
