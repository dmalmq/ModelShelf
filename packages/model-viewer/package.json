{
  "name": "model-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-independent 3D model viewer core with a React hook.",
  "exports": {
    ".": "./src/index.ts",
    "./ifc": "./src/ifc/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
