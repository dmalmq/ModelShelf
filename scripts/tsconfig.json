{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "./check-published-tree.ts",
    "./sync-tickets.ts",
    "./verify-worker-envelope.ts",
    "./lib/checker-harness.ts",
    "./lib/browser-proof.ts",
    "./lib/worker-envelope.ts",
    "./fixtures/fake-worker.ts"
  ]
}
