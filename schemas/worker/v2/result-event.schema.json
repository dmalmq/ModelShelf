{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-event.schema.json",
  "title": "ResultEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "jobId", "event", "manifest"],
  "properties": {
    "protocolVersion": { "$ref": "protocol-version.schema.json" },
    "jobId": { "type": "string", "minLength": 1 },
    "event": { "const": "result" },
    "manifest": { "$ref": "manifest-pointer.schema.json" }
  }
}
