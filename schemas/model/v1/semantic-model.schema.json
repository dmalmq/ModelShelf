{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-model.schema.json",
  "title": "SemanticModel",
  "description": "Classification, properties, and native-ID metadata for every occurrence in one revision, keyed by ObjectRef. Loadable independently of the revision's render manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revisionId", "objects"],
  "properties": {
    "schemaVersion": { "enum": ["model-v1"] },
    "revisionId": { "type": "string", "minLength": 1 },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticObject" }
    }
  },
  "$defs": {
    "semanticObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "classification"],
      "properties": {
        "ref": { "$ref": "object-ref.schema.json" },
        "nativeIds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expressId": { "type": "integer", "minimum": 1 },
            "globalId": { "type": "string", "minLength": 1 }
          }
        },
        "classification": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "storey": { "type": "string" },
        "placement": {
          "description": "Row-major 3x4 project-frame transform. Translations are metres. Omitted when the source placement cannot be interpreted.",
          "type": "array",
          "items": { "type": "number" },
          "minItems": 12,
          "maxItems": 12
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pset", "name", "values", "ordered", "origin"],
      "properties": {
        "pset": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "values": {
          "description": "One entry per stored value. List-valued IFC properties keep authoring order; unordered IFC sets set ordered=false.",
          "type": "array",
          "items": { "$ref": "#/$defs/propertyValue" }
        },
        "ordered": { "type": "boolean" },
        "origin": { "enum": ["occurrence", "type"] }
      }
    },
    "propertyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "originalUnit": { "type": "string" },
        "siValue": { "type": ["number", "null"] },
        "dimension": { "enum": ["length", "area", "volume"] }
      }
    }
  }
}
