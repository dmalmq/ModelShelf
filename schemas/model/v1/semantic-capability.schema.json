{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-capability.schema.json",
  "title": "SemanticCapability",
  "description": "Whether a revision's semantic (property/classification) artifact is available, deliberately absent, unsupported by the source format, or failed to produce. These four states are mutually exclusive by construction: a payload can satisfy at most one branch.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifactVersion", "contentHash", "objectCount"],
      "properties": {
        "status": { "const": "available" },
        "artifactVersion": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "objectCount": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "absent" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "unsupported" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "const": "failed" },
        "error": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
